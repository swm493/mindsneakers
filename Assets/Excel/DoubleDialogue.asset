    rightimage: Stacy_Gown_Gloomy
    activeside: Left
    context: "\uB3CC\uC544\uC624\uC2E0 \uAC78 \uD658\uC601\uD574\uC694. \uC624\uB298
      \uC815\uB9D0 \uD798\uB4DC\uC168\uB098 \uBCF4\uB124\uC694. \uC5B4\uB290 \uC815\uB3C4\uC758
      **\uD734\uC2DD-*\uC774 \uD544\uC694\uD574 \uBCF4\uC785\uB2C8\uB2E4. \uC0AC\uC6A9\uC790\uB2D8\uC758
      \uC800\uB141\uC744 \uC900\uBE44\uD574\uB4DC\uB9B4\uAE4C\uC694?"
  - groupid: 1
    id: 1005
    leftname: "\uC8FC\uC778\uACF5"
    leftimage: Hero_Normal
    rightname: "\uC2A4\uD14C\uC774\uC2DC"
    rightimage: Stacy_Gown_Default
    activeside: Right
    context: "\uADF8\uB798,  \uADF8\uB9AC\uACE0 \uC81C\uBC1C \uADF8 \uD654\uB098\uB294
      \uB9D0\uD22C \uC880 \uC5B4\uB5BB\uAC8C \uD560 \uC218 \uC5C6\uC5B4?"
  - groupid: 1
    id: 1006
    leftname: "\uC8FC\uC778\uACF5"
    leftimage: Hero_Normal
    rightname: "\uC2A4\uD14C\uC774\uC2DC"
    rightimage: Stacy_Gown_Default
    activeside: Left
    context: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4. \uC0AC\uC6A9\uC790\uB2D8\uC758 \uBD88\uD3B8\uC744
      \uCD08\uB798\uD588\uB124\uC694. \uC0AC\uC6A9\uC790\uB2D8\uC758 \uBD84\uB178\uB294
