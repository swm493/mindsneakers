      m_Calls: []
  m_text: "\uC2A4\uD14C\uC774\uC2DC\uC758 \uAE30\uC5B5 #2 - \uB300\uD559\uAD50\r\n\uACFC\uD559\uAE30\uC220\uACFC
    \uD604\uB300\uC0AC\uD68C - 10\uC8FC\uCC28 \uAC15\uC758\uC790\uB8CC\r\n\uAE30\uD6C4
    \uC0AC\uD0DC\uC640 \uC9C0\uAD6C \uC758\uD68C\uC758 \uACB0\uC131\r\n20xx\uB144,
    \uAD6D\uAC00 \uAC04 \uD611\uB825\uC758 \uBE44\uD6A8\uC728\uC131\uACFC \uAD6D\uAC00
    \uAC04 \uACBD\uC7C1\uC73C\uB85C \uC778\uD574 \uAE30\uD6C4 \uBCC0\uD654\uAC00
    \uC784\uACC4\uC810\uC744 \uB118\uC74C\uC5D0 \uB530\uB77C, \uC774\uB978\uBC14
    \uAE30\uD6C4 \uC0AC\uD0DC\uB77C \uBD88\uB9AC\uB294 \uC778\uAC04\uC758 \uC0DD\uC874\uC744
    \uC704\uD611\uD558\uB294 \uC815\uB3C4\uC758 \uAE30\uD6C4 \uBCC0\uD654\uAC00 \uC77C\uC5B4\uB098\uAC8C
    \uB418\uC5C8\uB2E4. \uADF8\uC5D0 \uB530\uB77C \uC778\uB958\uC758 \uC0DD\uC874\uC744
    \uC704\uD574 \uAD6D\uAC00 \uAC04 \uD611\uB825\uC758 \uD544\uC694\uC131\uC774
    \uB300\uB450\uB418\uAC8C \uB418\uC5C8\uACE0, \uC774\uB294 \uC2E4\uC9C8\uC801\uC778
    \uC815\uCE58\uC801 \uBC0F \uBB3C\uB9AC\uC801 \uD798\uC744 \uAC00\uC9C4 \uBC94\uAD6D\uAC00
    \uC815\uBD80 \u2018\uC9C0\uAD6C \uC758\uD68C\u2019\uC758 \uCD9C\uBC94\uC73C\uB85C
    \uC774\uC5B4\uC84C\uB2E4.\u2026..\r\n\uBE44\uCEE8 \uAE30\uC220\uACFC \uD604\uB300
    \uAD6D\uAC00\uC758 \uC124\uB9BD\r\n\uC9C0\uAD6C \uC758\uD68C\uC758 \uCD9C\uBC94
    \uC774\uD6C4, \uC9C0\uAD6C \uC758\uD68C\uB294 \uAE30\uD6C4 \uC0AC\uD0DC\uC758
    \uD574\uACB0\uC744 \uC704\uD574 \uD658\uACBD\uACF5\uD559 \uBD84\uC57C\uC5D0 \uB300\uB300\uC801\uC778
    \uC9C0\uC6D0\uC744 \uD558\uAE30 \uC2DC\uC791\uD588\uACE0, \uADF8 \uC131\uACFC\uB85C\uC11C
    \uB098\uB178\uBA38\uC2E0 \uC81C\uC5B4 \uAE30\uC220\uC758 \uC751\uC6A9\uC778 \uC54C\uC138\uC774\uC2A4
    \uCF54\uD37C\uB808\uC774\uC158\uC758 \uD658\uACBD \uD1B5\uC81C \uBE44\uCEE8 \uAE30\uC220\uC774
    \uAC1C\uBC1C\uB418\uAC8C \uB418\uC5C8\uB2E4. \uD658\uACBD \uD1B5\uC81C \uBE44\uCEE8\uC740
    \uD55C \uB3C4\uC2DC\uC758 \uC911\uC2EC\uCD95\uC73C\uB85C\uC11C \uAE30\uB2A5\uD558\uAC8C
    \uB418\uC5C8\uACE0, \uBA54\uAC00 \uBA54\uD2B8\uB85C\uD3F4\uB9AC\uC2A4 \uD615\uD0DC\uC758
    \uD604\uB300 \uAD6D\uAC00\uC758 \uAE30\uD2C0\uC744 \uB2E4\uC9C0\uAC8C \uB418\uC5C8\uB2E4\u2026\u2026.\r\n\uC815\uBCF4\uC0DD\uBA85\uACF5\uD559\uC758
    \uB300\uB450\uC640 \u2018\uC545\uB9C8\u2019\uC758 \uAC1C\uBC1C\r\n\uD658\uACBD
    \uD1B5\uC81C \uBE44\uCEE8\uC774 \uAC1C\uBC1C\uB41C \uC774\uD6C4\uC5D0\uB3C4 \uD658\uACBD\uB860\uC790\uB4E4
    \uC0AC\uC774\uC5D0\uC11C\uB294 \uD658\uACBD \uD1B5\uC81C \uBE44\uCEE8\uC740 \uAE30\uD6C4
    \uBB38\uC81C\uB97C \uB4A4\uB85C \uBBF8\uB8F0 \uBFD0\uC774\uBA70, \uAE30\uD6C4\uBCC0\uD654\uB97C
    \uD574\uACB0\uD560 \uADFC\uBCF8\uC801\uC778 \uD574\uACB0\uCC45\uC774 \uD544\uC694\uD558\uB2E4\uB294
    \uB2F4\uB860\uC774 \uC8FC\uB97C \uC774\uB8E8\uC5C8\uB2E4. \uC774\uB7EC\uD55C
    \uB2F4\uB860\uC5D0 \uC758\uD574 \uC8FC\uBAA9\uBC1B\uC740 \uAC83\uC774 \uC815\uBCF4\uC0DD\uBA85\uACF5\uD559\uC774\uB2E4.
    \uC815\uBCF4\uC0DD\uBA85\uACF5\uD559\uC758 \uBAA9\uD45C\uB294 \uC0DD\uBA85\uCCB4\uB97C
    \uC815\uBCF4\uD654\uD558\uC5EC \uAC00\uC0C1\uC138\uACC4\uC5D0 \uAC70\uC8FC\uD558\uB3C4\uB85D
    \uD558\uC5EC \uD658\uACBD\uC5D0 \uAC00\uD574\uC9C0\uB294 \uBD80\uB2F4\uC744 \uC904\uC774\uACE0\uC790
    \uD558\uB294 \uAC83\uC774\uC5C8\uB2E4. \uADF8 \uACFC\uC815\uC5D0\uC11C \uBBF8\uCE74\uC5D8
    \uCF54\uD37C\uB808\uC774\uC158\uC740 \uC0DD\uBA85\uCCB4\uC758 \uC815\uBCF4\uD654\uC5D0
    \uB300\uD55C \uB192\uC740 \uC774\uD574\uB3C4\uB97C \uBC14\uD0D5\uC73C\uB85C \uC778\uACF5
    \uC815\uBCF4\uC0DD\uBA85\uCCB4 \u2018DEMON\u2019, \uC77C\uBA85 \u2018\uC545\uB9C8\u2019\uB97C
    \uAC1C\uBC1C\uD558\uC5EC 3\uCC28 AI \uACA8\uC6B8\uC744 \uADF9\uBCF5\uD574\uB0B4\uAE30\uB3C4
    \uD588\uB2E4\u2026\u2026\r\n\uC545\uB9C8 \uC0AC\uD0DC\uC640 \uADF8 \uC601\uD5A5\r\n\u2018\uC545\uB9C8\u2019\uB4E4\uC774
    \uC0C1\uC6A9\uD654\uB418\uC5B4 \uAC00\uC815\uC6A9 \uC545\uB9C8\uAE4C\uC9C0 \uBCF4\uAE09\uB418\uB358
    20xx\uB144, \u2018\uC545\uB9C8\u2019\uB4E4\uC774 \uC54C \uC218 \uC5C6\uB294 \uC774\uC720\uB85C
    \uD1B5\uC81C \uBD88\uAC00\uB2A5\uD55C \uC815\uB3C4\uC758 \uACF5\uACA9\uC131\uACFC
    \uC778\uAC04 \uC815\uC2E0\uC5D0 \uB300\uD55C \uCE68\uD22C\uC131\uC744 \uBCF4\uC774\uAE30
    \uC2DC\uC791\uD588\uB2E4. \uADF8\uB85C \uC778\uD574 \uB9CE\uC740 \uC778\uAD6C\uAC00
    \u2018\uC545\uB9C8\u2019\uC5D0 \uC758\uD574 \uC815\uC2E0 \uC870\uC791 \uD53C\uD574\uB97C
    \uBCF4\uAC8C \uB418\uC5C8\uACE0, \uC9C0\uAD6C \uC758\uD68C\uB294 \uC774\uB97C
    \uAE30\uD6C4 \uC0AC\uD0DC\uC640 \uB3D9\uAE09\uC778 \uC801\uC0C9 \uC704\uD611
    \uB4F1\uAE09\uC73C\uB85C \uBD84\uB958\uD558\uACE0 \u2018\uC545\uB9C8 \uC0AC\uD0DC\u2019\uB77C
    \uBA85\uBA85\uD55C\uB2E4. \uC545\uB9C8 \uC0AC\uD0DC\uB294 \uC54C\uC138\uC774\uC2A4
    \uCF54\uD37C\uB808\uC774\uC158\uC758 \uAE30\uC220\uB825\uC744 \uC751\uC6A9\uD55C
    \uB9C8\uB974\uBCA0\uC2A4 \uCF54\uD37C\uB808\uC774\uC158\uC758 \uC545\uB9C8 \uD1B5\uC81C
    \uBE44\uCEE8 \uAE30\uC220\uC5D0 \uC758\uD574 \uC9C4\uC555\uB418\uC5C8\uC9C0\uB9CC,
    \uC644\uC804\uD788 \uC81C\uC555\uB418\uC9C0 \uC54A\uC740 \uC545\uB9C8\uB4E4\uC774
    \uBE44\uCEE8\uC758 \uC601\uD5A5\uC774 \uB2FF\uC9C0 \uC54A\uB294 \uC9C0\uC5ED\uC73C\uB85C
    \uC228\uC5B4\uB4E4\uC5B4\uAC00\uBA70 \uC57C\uC0DD \uC545\uB9C8\uB85C \uBCC0\uBAA8\uD558\uAC8C
    \uB418\uC5C8\uB2E4. \uC57C\uC0DD \uC545\uB9C8\uB4E4\uC740 \uD604\uC7AC\uAE4C\uC9C0\uB3C4
    \uC874\uC18D\uD558\uACE0 \uC788\uC73C\uBA70, \uBA54\uAC00\uBA54\uD2B8\uB85C\uD3F4\uB9AC\uC2A4
    \uAC04 \uBB3C\uC790 \uC6B4\uC1A1\uC5D0 \uC788\uC5B4 \uB9C8\uB974\uBCA0\uC2A4
    \uCF54\uD37C\uB808\uC774\uC158\uC758 \uBE44\uCEE8 \uAE30\uC220\uC774 \uD544\uC218\uBD88\uAC00\uACB0\uD55C
    \uC694\uC18C\uAC00 \uB41C \uC774\uC720\uC774\uAE30\uB3C4 \uD558\uB2E4\u2026.\r\n"
