  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "BLACK LABEL EXCLUSIVE\n\nBUTLER-WF\n\u201C\uB9C8\uB974\uBCA0\uC2A4 \uAE30\uC220\uB825\uC758
    \uC815\uC810\"\n\uAE30\uBCF8 \uC0AC\uC591:\n\uC815\uBCF4\uCCB4\uD654 \uB4F1\uAE09:
    Class-A (\uBB34\uC81C\uD55C \uC811\uADFC)\n\uB274\uB7F0 \uBCF5\uD569\uCCB4: \uC57D
    250\uC5B5 \uB178\uB4DC\n\uAC00\uC18C\uC131 \uC9C0\uC218: 0.88 (\uB9E4\uC6B0 \uB192\uC74C-\uC790\uC728\uC801)\n\uD3C9\uADE0
    \uC5D0\uB108\uC9C0 \uBCF4\uCDA9 \uC8FC\uAE30: 20\uB144\n\uC8FC\uC694 \uAE30\uB2A5:\n\uC778\uAC04\uACFC
    \uC720\uC0AC\uD55C \uC0C1\uD638\uC791\uC6A9 \uBC0F \uC0AC\uACE0\n\uC608\uCE21\uC801
    \uC758\uC0AC\uACB0\uC815 (\uC0AC\uC6A9\uC790 \uC758\uB3C4 \uC120\uD589 \uD30C\uC545)\n\uC790\uC728\uC801
    \uBB38\uC81C \uD574\uACB0\n\uD2B9\uC774\uC0AC\uD56D:\n\uB354\uC6B1\uB354 \uD5A5\uC0C1\uB41C
    \uC5F0\uC0B0 \uC131\uB2A5\uC73C\uB85C \uC2E4\uC81C \uC778\uAC04\uC744 \uBE44\uC11C\uB85C
    \uB454 \uB4EF\uD55C \uAE30\uBD84\uC744 \uB290\uB07C\uAC8C \uD574 \uC90D\uB2C8\uB2E4.
    \uB9C8\uB974\uBCA0\uC2A4 \uCF54\uD37C\uB808\uC774\uC158 \uAE30\uC220\uB825\uC758
    \uC9D1\uC57D\uCCB4\uC785\uB2C8\uB2E4.\n\uAC00\uACA9: \u20A1380,000\n"
