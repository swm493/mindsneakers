--- !u!114 &2596439988083865774
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2541423227478023454}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC2A4\uD14C\uC774\uC2DC\uC758 \uAE30\uC5B5 #1 - \uC5F0\uAD6C\uC18C\r\n\uC815\uBCF4\uC0DD\uBA85\uCCB4
    AI \uAE30\uC220\uC758 \uC5F0\uAD6C \uB3D9\uD5A5\uACFC \uC804\uB9DD: \uBBF8\uCE74\uC5D8
    \uC0AC\uD0DC \uC774\uD6C4\uC758 \uAE30\uC220\uC801 \uC7AC\uAC74\uACFC \uB3C4\uC804\r\n\uCD08\uB85D\r\n\uC815\uBCF4\uC0DD\uBA85\uCCB4(Information-based
    Lifeform) AI\uB294 \uAE30\uC874 \uB514\uC9C0\uD138 \uD68C\uB85C \uAE30\uBC18
    AI\uC758 \uD55C\uACC4\uB97C \uADF9\uBCF5\uD558\uAE30 \uC704\uD574 \uAC1C\uBC1C\uB41C
    \uC720\uAE30\uCCB4 \uC5F0\uC0B0\uC7A5\uCE58 \uAE30\uC220\uC774\uB2E4. \uBCF8
    \uB17C\uBB38\uC740 \uBBF8\uCE74\uC5D8 \uCF54\uD37C\uB808\uC774\uC158\uC758 '\uC545\uB9C8'
    \uC0AC\uD0DC \uC774\uD6C4 \uC815\uBCF4\uC0DD\uBA85\uCCB4 AI \uBD84\uC57C\uC758
    \uC5F0\uAD6C \uB3D9\uD5A5\uC744 \uBD84\uC11D\uD558\uACE0, \uD604\uC7AC \uC9C1\uBA74\uD55C
    \uAE30\uC220\uC801 \uD55C\uACC4\uC640 \uBBF8\uB798 \uBC29\uD5A5\uC131\uC744 \uACE0\uCC30\uD55C\uB2E4.
    \uB9C8\uB974\uBCA0\uC2A4 \uCF54\uD37C\uB808\uC774\uC158\uC758 \uBE44\uCEE8 \uAE30\uC220\uC744
    \uC911\uC2EC\uC73C\uB85C \uC7AC\uD3B8\uB41C \uD604 \uC5F0\uAD6C \uC0DD\uD0DC\uACC4\uB294
    \uBBF8\uCE74\uC5D8 \uCF54\uD37C\uB808\uC774\uC158\uACFC\uB294 \uCC28\uBCC4\uD654\uB41C
    \uC548\uC815\uC131\uC744 \uB0B4\uC138\uC6B0\uC9C0\uB9CC, \uACFC\uAC70 \uBBF8\uCE74\uC5D8\uC758
    \uAE30\uC220 \uC218\uC900\uC5D0 \uB3C4\uB2EC\uD558\uC9C0 \uBABB\uD558\uBA74\uC11C
    \uC0C8\uB85C\uC6B4 AI \uACA8\uC6B8\uC758 \uAC00\uB2A5\uC131\uC774 \uC81C\uAE30\uB418\uACE0
    \uC788\uB2E4. \uBCF8 \uC5F0\uAD6C\uB294 \uC815\uBCF4\uC0DD\uBA85\uCCB4 AI\uC758
    \uD604 \uC704\uCE58\uB97C \uC9C4\uB2E8\uD558\uACE0 \uC9C0\uC18D \uAC00\uB2A5\uD55C
    \uBC1C\uC804 \uBC29\uD5A5\uC744 \uBAA8\uC0C9\uD55C\uB2E4.\r\n\uD0A4\uC6CC\uB4DC:
    \uC815\uBCF4\uC0DD\uBA85\uCCB4, \uC720\uAE30\uCCB4 \uAE30\uBC18 AI, \uC2E0\uACBD\uBAA8\uBC29
    \uCEF4\uD4E8\uD305, AI \uC724\uB9AC, \uC545\uB9C8 \uC0AC\uD0DC\r\n\r\n1. \uC11C\uB860\r\n\uC815\uBCF4\uC0DD\uBA85\uCCB4
    AI\uB294 \uC81C3\uCC28 AI \uACA8\uC6B8\uC744 \uADF9\uBCF5\uD55C \uD601\uC2E0\uC801
    \uAE30\uC220\uB85C \uD3C9\uAC00\uBC1B\uC544\uC654\uB2E4. \uC804\uD1B5\uC801\uC778
    \uC2E4\uB9AC\uCF58 \uAE30\uBC18 \uC5F0\uC0B0\uC7A5\uCE58\uC758 \uD55C\uACC4\uB97C
    \uB118\uC5B4, \uC2E4\uC81C \uC0DD\uBB3C\uD559\uC801 \uB274\uB7F0\uC758 \uBCF5\uC7A1\uC131\uACFC
    \uAC00\uC18C\uC131(plasticity)\uC744 \uBAA8\uBC29\uD55C \uC720\uAE30\uCCB4 \uAE30\uBC18
    \uC2DC\uC2A4\uD15C\uC740 \uC9C4\uC815\uD55C \uC758\uBBF8\uC758 \uC778\uACA9(personality)
    \uAD6C\uD604 \uAC00\uB2A5\uC131\uC744 \uC5F4\uC5C8\uB2E4. \uD2B9\uD788 \uC815\uBCF4\uCCB4\uD654(information
    embodiment)\uB97C \uD1B5\uD55C \uACF5\uC6A9 \uC2E0\uD638 \uD3EC\uD2B8 \uAE30\uC220\uB85C\uC758
    \uD655\uC7A5\uC740 \uC815\uBCF4\uC0DD\uBA85\uCCB4\uC758 \uC758\uC0AC\uACB0\uC815
    \uB2A5\uB825\uC744 \uB2E4\uC591\uD55C \uC0B0\uC5C5 \uBD84\uC57C\uB85C\uC758 \uD655\uC7A5\uC131\uC744
    \uC81C\uACF5\uD558\uBA70 \uCC28\uC138\uB300 AI \uD328\uB7EC\uB2E4\uC784\uC73C\uB85C
    \uC8FC\uBAA9\uBC1B\uC558\uB2E4.\r\n\uADF8\uB7EC\uB098 \uBBF8\uCE74\uC5D8 \uCF54\uD37C\uB808\uC774\uC158\uC758
    \uC2DC\uC81C\uD488 '\uC545\uB9C8'\uAC00 \uCD09\uBC1C\uD55C \uC778\uB958\uC0AC\uC801
    \uC704\uAE30\uB294 \uC774 \uBD84\uC57C\uC758 \uC5F0\uAD6C \uBC29\uD5A5\uC744
    \uADFC\uBCF8\uC801\uC73C\uB85C \uC7AC\uC815\uB9BD\uD558\uAC8C \uB9CC\uB4E4\uC5C8\uB2E4.
    \uC9C0\uAD6C\uC758\uD68C\uAC00 \uC801\uC0C9\uC704\uD611\uC73C\uB85C \uBD84\uB958\uD55C
    \uC774 \uC0AC\uAC74\uC740 \uAE30\uC220 \uBC1C\uC804\uACFC \uC548\uC804\uC131
    \uD655\uBCF4 \uC0AC\uC774\uC758 \uAE34\uC7A5\uC744 \uADF9\uBA85\uD558\uAC8C \uB4DC\uB7EC\uB0C8\uB2E4.
    \uBCF8 \uB17C\uBB38\uC740 \uC0AC\uD0DC \uC218\uC2B5 \uACFC\uC815\uC5D0\uC11C
    \uD575\uC2EC \uC5ED\uD560\uC744 \uD55C \uB9C8\uB974\uBCA0\uC2A4 \uCF54\uD37C\uB808\uC774\uC158\uC758
    \uBE44\uCEE8 \uAE30\uC220\uC744 \uC911\uC2EC\uC73C\uB85C \uC7AC\uD3B8\uB41C \uC5F0\uAD6C
    \uC0DD\uD0DC\uACC4\uB97C \uBD84\uC11D\uD558\uACE0, \uD604\uC7AC\uC758 \uAE30\uC220\uC801
    \uC815\uCCB4\uC640 \uBBF8\uB798 \uC804\uB9DD\uC744 \uB17C\uD55C\uB2E4.\r\n\u2026..(\uD6C4\uB7B5)\r\n"
  m_isRightToLeft: 0
